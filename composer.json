{
    "name": "yuga/livecomponent",
    "description": "Live components for the Yuga Framework.",
    "keywords": ["yuga", "live", "components"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Hamidouh Semix",
            "email": "semix.hamidouh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "yuga/framework": "^5.0"
    },
    "autoload": {
        "files": [
            "src/Support/helpers.php"
        ],
        "psr-4": {
            "Yuga\\Live\\": "src/"
        }
    },
    "extra": {
        "yuga": {
            "providers": [
                "Yuga\\Live\\YlcProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}